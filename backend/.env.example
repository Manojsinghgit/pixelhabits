# Copy this file to .env and fill in real values. Never commit the real .env.

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True locally, False in production
DEBUG=True

# Comma-separated hostnames the app is allowed to serve, e.g. myapp.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: either allow everything (dev only) or list specific origins (prod)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Only required in production (habittracker.settings.prod).
# Render/Railway inject this automatically when you attach a Postgres addon.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Optional: Firebase Cloud Messaging server key, for push notification reminders
FCM_SERVER_KEY=
